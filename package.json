{
  "name": "festa",
  "version": "0.1.0",
  "private": true,
  "description": "Jogo de festa para PC com telemóveis como comandos",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm run dev -w @festa/server\" \"npm run dev -w @festa/web\"",
    "dev:https": "cross-env FESTA_HTTPS=1 npm run dev",
    "build": "npm run build -w @festa/web",
    "start": "npm run start -w @festa/server",
    "start:https": "cross-env HTTPS=1 npm run start -w @festa/server",
    "online": "tsx tools/online.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2"
  }
}
